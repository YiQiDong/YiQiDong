@page "/login"

<div class="row">
    <div class="col-md-6 col-sm-12 mb-3">
        <div class="form-group">
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"> <i class="fa fa-lock"></i> </span>
                </div>
                <input class="form-control @(string.IsNullOrEmpty(Message) ? "" : "is-invalid")" placeholder="请输入密码"
                       type="password" autocomplete="off" @bind-value="Password" @bind-value:event="oninput"
                       @onkeypress="onPasswordKeyPress" required autofocus />
                @if (!string.IsNullOrEmpty(Message))
                {
                    <div class="invalid-feedback">
                        @(Message)
                    </div>
                }
            </div>
        </div>
        <div class="form-group">
            <input type="button" class="btn btn-success btn-block" value="登录" @onclick="OnPost" />
        </div>
        <p class="card-text"><small class="text-muted">版本：@Consts.Version-@Consts.ARCH</small></p>
    </div>
</div>