@inherits LayoutComponentBase

<PageTitle>@Title</PageTitle>

<div class="page">
    @if (IsLoading)
    {
        <Modal Visiable DialogBackdropVisiable DialogCentered>
            <TitleContent>
                <img src="logo.svg" class="mr-2" width="30" height="30" />
                @Title
            </TitleContent>
            <BodyContent>
                <p></p>
                <div class="progress">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar"
                         style="width: 100%" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100"></div>
                </div>
                <p><small id="loginWindowWarning" class="text-muted"></small></p>
            </BodyContent>
            <FooterContent>
                <p class="card-text"><small class="text-muted">版本：@Consts.Version-@Consts.ARCH</small></p>
            </FooterContent>
        </Modal>
    }
    else
    {
        <div class="sidebar">
            <YiQiDong.Components.Layout.NavMenu />
        </div>

        <div class="main">
            <div class="content px-4">
                @if (IsShowDataFolderWarning())
                {
                    <div class="alert alert-danger" role="alert">
                        警告：当前配置的数据目录[@Program.Config.DataFolder]存在风险，更新或删除软件时会删除整个安装目录，镜像和容器文件有被删除的重大风险！请及时修改数据目录为其他路径。
                    </div>
                }
                @if (!Program.IsStartSuccess)
                {
                    <div class="alert alert-danger" role="alert">
                        警告：启动时出错，请在左侧“错误信息”菜单中查看详细错误日志。
                    </div>
                }
                @if (Program.IsDebugRuning)
                {
                    <div class="alert alert-danger" role="alert">
                        警告：当前为调试运行，仅用于启动测试。正式使用时请使用服务方式运行。
                    </div>
                }
                @Body
            </div>
        </div>
    }
</div>
