@using System.Security.Cryptography

<div class="modal-body">
    <EditForm Model="@createModel" OnValidSubmit="Ok">
        <DataAnnotationsValidator />
        <Tabs NavTabsExtraClass="mb-3">
            <TabPane Key="1">
                <Tab>通用</Tab>
                <ChildContent>
                    <div class="form-group">
                        <label>镜像</label>
                        @if (Model == null || Model.Image == null)
                        {
                            <InputSelect @bind-Value="createModel.ImageId" class="form-control">
                                <option value="">请选择</option>
                                @foreach (var t in Core.ImageManager.Instance.Query(null, null))
                                {
                                    <option value="@t.Id">@t.Name [@t.Version]</option>
                                }
                            </InputSelect>
                            <ValidationMessage For="@(() => createModel.ImageId)" />
                        }
                        else
                        {
                            <input type="text" class="form-control" readonly
                                value="@Model.Image?.Name [@Model.Image?.Version]" />
                        }
                    </div>
                    <div class="form-group">
                        <label>编号</label>
                        <InputText class="form-control" @bind-Value="createModel.Id" />
                        <ValidationMessage For="@(() => createModel.Id)" />
                    </div>
                    <div class="form-group">
                        <label>名称</label>
                        <InputText class="form-control" @bind-Value="createModel.Name" />
                        <ValidationMessage For="@(() => createModel.Name)" />
                    </div>
                    <div class="form-group">
                        <label>描述</label>
                        <InputText class="form-control" @bind-Value="createModel.Description" />
                        <ValidationMessage For="@(() => createModel.Description)" />
                    </div>
                    <div class="form-group">
                        <label>标签</label>
                        @if (selectTags != null)
                        {
                            <p>

                                @foreach (var tag in selectTags)
                                {
                                    <button type="button" class="btn btn-sm m-1 @(tag.Checked ? "btn-info" : "btn-light")"
                                        @onclick="@(e => checkTag(tag))">@tag.Name</button>
                                }
                            </p>
                        }
                    </div>
                    <div class="form-group">
                        <label>运行库</label>
                        @if (selectRuntimes != null)
                        {
                            <p>

                                @foreach (var runtime in selectRuntimes)
                                {
                                    <button type="button"
                                        class="btn btn-sm m-1 @(runtime.Checked ? "btn-info" : "btn-light")"
                                        @onclick="@(e => checkRuntime(runtime))">@runtime.Id</button>
                                }
                            </p>
                        }
                    </div>
                </ChildContent>
            </TabPane>
            <TabPane Key="2">
                <Tab>脚本</Tab>
                <ChildContent>
                    <div class="form-group">
                        <label>启动脚本</label>
                        <InputTextArea class="form-control" @bind-Value="createModel.StartScript" />
                        <ValidationMessage For="@(() => createModel.StartScript)" />
                    </div>
                    <div class="form-group">
                        <label>停止脚本</label>
                        <InputTextArea class="form-control" @bind-Value="createModel.StopScript" />
                        <ValidationMessage For="@(() => createModel.StopScript)" />
                    </div>
                </ChildContent>
            </TabPane>
            <TabPane Key="3">
                <Tab>日志</Tab>
                <ChildContent>
                    <div class="form-group">
                        <label>日志级别</label>
                        <InputSelect @bind-Value="createModel.LogLevel" class="form-control">
                            <option value="Trace">Trace - 追踪</option>
                            <option value="Debug">Debug - 调试</option>
                            <option value="Info">Info - 信息</option>
                            <option value="Warn">Warn - 警告</option>
                            <option value="Error">Error - 错误</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => createModel.LogLevel)" />
                    </div>
                    <div class="form-group">
                        <label>日志记录</label>
                        <InputSelect @bind-Value="createModel.EnableRecordLogStr" class="form-control">
                            <option value="False">禁用</option>
                            <option value="True">启用</option>
                        </InputSelect>
                        <ValidationMessage For="@(() => createModel.EnableRecordLog)" />
                        <small id="passwordHelpBlock" class="form-text text-muted">
                            日志文件按日期保存，每天一个日志文件，存放在容器目录下的YiQiDong.Container.Logs目录下面
                        </small>
                    </div>
                    <div class="form-group">
                        <label>日志保存天数</label>
                        <InputNumber class="form-control" @bind-Value="createModel.LogSaveDays" />
                        <ValidationMessage For="@(() => createModel.LogSaveDays)" />
                        <small id="passwordHelpBlock" class="form-text text-muted">
                            保存最近多少天的日志文件，如果设置为0时则不删除日志。
                        </small>
                    </div>
                </ChildContent>
            </TabPane>
            <TabPane Key="4">
                <Tab>环境变量</Tab>
                <ChildContent>
                    <div class="form-group">
                        <InputTextArea class="form-control" @bind-Value="createModel.EnvironmentVariables" rows="10" />
                        <ValidationMessage For="@(() => createModel.EnvironmentVariables)" />
                    </div>
                </ChildContent>
            </TabPane>
            <TabPane Key="5">
                <Tab>连接</Tab>
                <ChildContent>
                    <div class="form-group">
                        <label>启用压缩</label>
                        <div class="custom-control custom-switch">
                            <InputCheckbox class="custom-control-input" @bind-Value="createModel.EnableCompress" id="createModel_EnableCompress" />
                            <label class="custom-control-label" for="createModel_EnableCompress"></label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>启用加密</label>
                        <div class="custom-control custom-switch">
                            <InputCheckbox class="custom-control-input" @bind-Value="createModel.EnableEncrypt" id="createModel_EnableEncrypt" />
                            <label class="custom-control-label" for="createModel_EnableEncrypt"></label>
                        </div>
                    </div>
                    @if(createModel.EnableEncrypt)
                    {
                        <div class="form-group">
                            <label>加密算法</label>
                            <InputSelect @bind-Value="createModel.EncryptAlgorithm" class="form-control">
                                <option value="DES">DES</option>
                                <option value="AES">AES</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => createModel.EncryptAlgorithm)" />
                        </div>
                        <div class="form-group">
                            <label>加密模式</label>
                            <InputSelect @bind-Value="createModel.EncryptMode" class="form-control">
                                <option value="@nameof(CipherMode.CBC)">@nameof(CipherMode.CBC)</option>
                                <option value="@nameof(CipherMode.ECB)">@nameof(CipherMode.ECB)</option>
                                <option value="@nameof(CipherMode.OFB)">@nameof(CipherMode.OFB)</option>
                                <option value="@nameof(CipherMode.CFB)">@nameof(CipherMode.CFB)</option>
                                <option value="@nameof(CipherMode.CTS)">@nameof(CipherMode.CTS)</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => createModel.EncryptMode)" />
                        </div>
                        <div class="form-group">
                            <label>加密填充</label>
                            <InputSelect @bind-Value="createModel.EncryptPadding" class="form-control">
                                <option value="@nameof(PaddingMode.None)">@nameof(PaddingMode.None)</option>
                                <option value="@nameof(PaddingMode.PKCS7)">@nameof(PaddingMode.PKCS7)</option>
                                <option value="@nameof(PaddingMode.Zeros)">@nameof(PaddingMode.Zeros)</option>
                                <option value="@nameof(PaddingMode.ANSIX923)">@nameof(PaddingMode.ANSIX923)</option>
                                <option value="@nameof(PaddingMode.ISO10126)">@nameof(PaddingMode.ISO10126)</option>
                            </InputSelect>
                            <ValidationMessage For="@(() => createModel.EncryptPadding)" />
                        </div>
                    }
                    <div class="form-group">
                        <label>传输超时</label>
                        <InputNumber class="form-control" @bind-Value="createModel.TransportTimeout" />
                        <ValidationMessage For="@(() => createModel.TransportTimeout)" />
                        <small id="passwordHelpBlock" class="form-text text-muted">
                            单位：毫秒
                        </small>
                    </div>
                </ChildContent>
            </TabPane>
            <TabPane Key="6">
                <Tab>其他</Tab>
                <ChildContent>                    
                    <div class="form-group">
                        <label>启动警告</label>
                        <InputTextArea class="form-control" @bind-Value="createModel.StartWarning" />
                        <ValidationMessage For="@(() => createModel.StartWarning)" />
                    </div>
                    <div class="form-group">
                        <label>停止警告</label>
                        <InputTextArea class="form-control" @bind-Value="createModel.StopWarning" />
                        <ValidationMessage For="@(() => createModel.StopWarning)" />
                    </div>
                    <div class="form-group">
                        <label>定时启动</label>
                        <InputText class="form-control" @bind-Value="createModel.StartCron" />
                        <ValidationMessage For="@(() => createModel.StartCron)" />
                        <small class="form-text text-muted">
                            cron表达式
                        </small>
                    </div>
                    <div class="form-group">
                        <label>定时停止</label>
                        <InputText class="form-control" @bind-Value="createModel.StopCron" />
                        <ValidationMessage For="@(() => createModel.StopCron)" />
                        <small class="form-text text-muted">
                            cron表达式
                        </small>
                    </div>
                    <div class="form-group">
                        <label>定时重启</label>
                        <InputText class="form-control" @bind-Value="createModel.RestartCron" />
                        <ValidationMessage For="@(() => createModel.RestartCron)" />
                        <small class="form-text text-muted">
                            cron表达式
                        </small>
                    </div>
                </ChildContent>
            </TabPane>

        </Tabs>
        <button type="submit" class="btn btn-primary col-sm-5 col-md-4 col-lg-2">确定</button>
    </EditForm>
</div>