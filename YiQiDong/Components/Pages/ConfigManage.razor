@using Quick.Blazor.Bootstrap

<Tabs>
    <TabPane Key="Common">
        <Tab>通用</Tab>
        <ChildContent>
            <div class="card" style="border-top: none;border-top-left-radius: 0;border-top-right-radius: 0;">
                <div class="card-body">
                    <EditForm Model="@configModel" OnValidSubmit="ModifyConfigModel">
                        <DataAnnotationsValidator />
                        <div class="form-group">
                            <label>标题</label>
                            <InputText class="form-control" @bind-Value="configModel.Title" />
                            <ValidationMessage For="@(() => configModel.Title)" />
                        </div>
                        <div class="form-group">
                            <label>URL</label>
                            <InputText class="form-control" @bind-Value="configModel.Urls" />
                            <small class="form-text text-muted">主机中的星号代表绑定全部IP地址，一般情况不用修改成特定IP地址。</small>
                            <ValidationMessage For="@(() => configModel.Urls)" />
                        </div>
                        <div class="form-group">
                            <label>数据目录</label>
                            <InputText class="form-control" @bind-Value="configModel.DataFolder" />
                            <ValidationMessage For="@(() => configModel.DataFolder)" />
                        </div>
                        @if (OperatingSystem.IsLinux())
                        {
                            <div class="form-group">
                                <label>语言</label>
                                <InputSelect class="form-control" @bind-Value="configModel.LinuxOSLang">
                                    <option value="">默认</option>
                                    <option value="zh_CN.UTF-8">中文（中国）</option>
                                    <option value="en_US.UTF-8">英文（美国）</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => configModel.LinuxOSLang)" />
                            </div>
                            <div class="form-group">
                                <label>时区</label>
                                <InputSelect class="form-control" @bind-Value="configModel.LinuxOSTimeZone">
                                    <option value="">默认</option>
                                    <option value="Asia/Shanghai">中国标准时间</option>
                                    <option value="Etc/UTC">协调世界时</option>
                                </InputSelect>
                                <ValidationMessage For="@(() => configModel.LinuxOSTimeZone)" />
                            </div>
                        }
                        <div class="form-group">
                            <label>默认HTML</label>
                            <InputTextArea class="form-control" rows="5" @bind-Value="configModel.DefaultHtml" />
                            <small class="form-text text-muted">为空时，显示易启动主页面</small>
                            <ValidationMessage For="@(() => configModel.DefaultHtml)" />
                        </div>
                        <button type="submit" class="btn btn-secondary col-sm-5 col-md-4 col-lg-2">保存</button>
                    </EditForm>
                </div>
            </div>
        </ChildContent>
    </TabPane>
    <TabPane Key="Password">
        <Tab>密码</Tab>
        <ChildContent>
            <div class="card" style="border-top: none;border-top-left-radius: 0;border-top-right-radius: 0;">
                <div class="card-body">
                    <EditForm Model="@passwordManageModel" OnValidSubmit="ModifyPassword">
                        <DataAnnotationsValidator />
                        <div class="form-group">
                            <label>原密码</label>
                            <InputText class="form-control" type="password"
                                @bind-Value="passwordManageModel.OldPassword" />
                            <ValidationMessage For="@(() => passwordManageModel.OldPassword)" />
                        </div>
                        <div class="form-group">
                            <label>新密码</label>
                            <InputText class="form-control" type="password"
                                @bind-Value="passwordManageModel.NewPassword" />
                            <ValidationMessage For="@(() => passwordManageModel.NewPassword)" />
                        </div>
                        <div class="form-group">
                            <label>再次输入新密码</label>
                            <InputText class="form-control" type="password"
                                @bind-Value="passwordManageModel.NewPassword2" />
                            <ValidationMessage For="@(() => passwordManageModel.NewPassword2)" />
                        </div>
                        <button type="submit" class="btn btn-secondary col-sm-5 col-md-4 col-lg-2">保存</button>
                    </EditForm>
                </div>
            </div>
        </ChildContent>
    </TabPane>
    <TabPane Key="Advance">
        <Tab>高级</Tab>
        <ChildContent>
            <div class="card" style="border-top: none;border-top-left-radius: 0;border-top-right-radius: 0;">
                <div class="card-body">
                    <EditForm Model="@configModel" OnValidSubmit="ModifyConfigModel">
                        <DataAnnotationsValidator />
                        <div class="form-group">
                            <label>容器初始化间隔时间</label>
                            <InputNumber class="form-control" @bind-Value="configModel.AgentInitInterval" />
                            <small class="form-text text-muted">单位：毫秒</small>
                            <ValidationMessage For="@(() => configModel.AgentInitInterval)" />
                        </div>
                        <div class="form-group">
                            <label>容器传输超时</label>
                            <InputNumber class="form-control" @bind-Value="configModel.AgentTransportTimeout" />
                            <small class="form-text text-muted">单位：毫秒</small>
                            <ValidationMessage For="@(() => configModel.AgentTransportTimeout)" />
                        </div>
                        <div class="form-group">
                            <label>上传缓冲区大小</label>
                            <InputNumber class="form-control" @bind-Value="configModel.UploadBufferSize" />
                            <small class="form-text text-muted">网络条件好时，可以适当增大此参数以提高上传性能。网络条件差时，需要调低此参数以避免上传失败。</small>
                            <ValidationMessage For="@(() => configModel.UploadBufferSize)" />
                        </div>
                        <div class="form-group">
                            <label>环境变量</label>
                            <InputTextArea class="form-control" @bind-Value="configModel.EnvironmentVariables" />
                            <small class="form-text text-muted">一行一条记录，用等号分隔</small>
                            <ValidationMessage For="@(() => configModel.EnvironmentVariables)" />
                        </div>
                        <div class="form-group">
                            <label>启动脚本</label>
                            <InputTextArea class="form-control" @bind-Value="configModel.StartScript" />
                            <small class="form-text text-muted">程序启动时执行的脚本</small>
                            <ValidationMessage For="@(() => configModel.StartScript)" />
                        </div>
                        <div class="form-group">
                            <label>停止脚本</label>
                            <InputTextArea class="form-control" @bind-Value="configModel.StopScript" />
                            <small class="form-text text-muted">程序停止时执行的脚本</small>
                            <ValidationMessage For="@(() => configModel.StopScript)" />
                        </div>
                        <button type="submit" class="btn btn-secondary col-sm-5 col-md-4 col-lg-2">保存</button>
                    </EditForm>
                </div>
            </div>
        </ChildContent>
    </TabPane>
    <TabPane Key="Update">
        <Tab>更新</Tab>
        <ChildContent>
            <div class="card" style="border-top: none;border-top-left-radius: 0;border-top-right-radius: 0;">
                <div class="card-body">
                    <div class="alert alert-info" role="alert">
                        当前软件版本：@(Consts.Version)-@(Consts.ARCH)
                    </div>
                    <div class="btn-group mr-2 mb-1">
                        <div class="btn btn-secondary">
                            <i class="fa fa-upload" aria-hidden="true"></i> 上传更新
                            <input @ref="inputUpdateFile" id="inputUpdateFile" type="file" accept=".zip" style="width: 0px; height: 0px; visibility: collapse;" @onchange="UploadUpdate">
                            <label title="上传更新" style="position: absolute;top: 0;left: 0;right:0;margin:0;height:100%;cursor:pointer" for="inputUpdateFile">
                            </label>
                        </div>
                        <button type="button" class="btn btn-secondary" @onclick="SelectUpdate">
                            <i class="fa fa-reply" aria-hidden="true"></i>
                            选择更新
                        </button>
                        <button type="button" class="btn btn-secondary" @onclick="UrlUpdate">
                            <i class="fa fa-cloud-upload" aria-hidden="true"></i>
                            URL更新
                        </button>
                    </div>
                </div>
            </div>
        </ChildContent>
    </TabPane>
    <TabPane Key="Restart">
        <Tab>重启</Tab>
        <ChildContent>
            <div class="card" style="border-top: none;border-top-left-radius: 0;border-top-right-radius: 0;">
                <div class="card-body">
                    <button type="button" class="btn btn-secondary" @onclick="btnRestart_Click">开始重启</button>
                </div>
            </div>
        </ChildContent>
    </TabPane>
</Tabs>

<ModalWindow @ref="modalWindow" DialogCentered="false" DialogSizeExtraLarge="true" ModalBodyCls="p-0"></ModalWindow>
<ModalLoading @ref="modalLoading" />
<ModalAlert @ref="modalAlert" />
<ModalPrompt @ref="modalPrompt" />