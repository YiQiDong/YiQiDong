<div class="top-row pl-4 navbar navbar-dark">
    <a class="navbar-brand" href="/">@Program.Config.Title</a>
    <button class="navbar-toggler" @onclick="ToggleNavMenu">
        <span class="navbar-toggler-icon"></span>
    </button>
</div>
<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <ul class="nav flex-column">
        <AuthorizeView>
            <Authorized>
                @if (Program.IsStartSuccess)
                {
                    <li class="nav-item px-3">
                        <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                            <i class="fa fa-home" aria-hidden="true"></i>主页
                        </NavLink>
                    </li>
                    <li class="nav-item px-3">
                        <NavLink class="nav-link" href="runtimes" Match="NavLinkMatch.All">
                            <i class="fa fa-life-bouy" aria-hidden="true"></i>运行库管理
                        </NavLink>
                    </li>
                    <li class="nav-item px-3">
                        <NavLink class="nav-link" href="images" Match="NavLinkMatch.All">
                            <i class="fa fa-archive" aria-hidden="true"></i>镜像管理
                        </NavLink>
                    </li>
                    <li class="nav-item px-3">
                        <NavLink class="nav-link" href="containers" Match="NavLinkMatch.All">
                            <i class="fa fa-cube" aria-hidden="true"></i>容器管理
                        </NavLink>
                    </li>
                    <li class="nav-item px-3">
                        <NavLink class="nav-link" href="tools" Match="NavLinkMatch.All">
                            <i class="fa fa-cutlery" aria-hidden="true"></i>实用工具
                        </NavLink>
                    </li>
                    <li class="nav-item px-3">
                        <NavLink class="nav-link" href="config" Match="NavLinkMatch.All">
                            <i class="fa fa-sliders" aria-hidden="true"></i>系统设置
                        </NavLink>
                    </li>
                    <li class="nav-item px-3">
                        <form action="logout" method="post">
                            <AntiforgeryToken />
                            <button type="submit" class="nav-link">
                                <i class="fa fa-sign-out" aria-hidden="true"></i>退出
                            </button>
                        </form>
                    </li>
                }
                else
                {
                    <li class="nav-item px-3">
                        <NavLink class="nav-link" href="errors" Match="NavLinkMatch.All">
                            <i class="fa fa-cube" aria-hidden="true"></i>错误日志
                        </NavLink>
                    </li>
                }
            </Authorized>
            <NotAuthorized>
                <li class="nav-item px-3">
                    <NavLink class="nav-link" href="login" Match="NavLinkMatch.All">
                        <i class="fa fa-lock" aria-hidden="true"></i>登录
                    </NavLink>
                </li>
            </NotAuthorized>
        </AuthorizeView>
    </ul>
</div>